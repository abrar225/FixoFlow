# Static Next.js export on Hostinger/LiteSpeed. Preserve this dotfile on upload.
Options -Indexes
AddType application/x-apple-diskimage .dmg
AddType application/vnd.microsoft.portable-executable .exe
AddType application/vnd.debian.binary-package .deb

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    <FilesMatch "\.(dmg|exe|deb)$">
        Header set Content-Disposition "attachment"
        Header set Cache-Control "public, max-age=3600, no-transform"
    </FilesMatch>
</IfModule>
<IfModule mod_setenvif.c>
    SetEnvIfNoCase Request_URI "\.(dmg|exe|deb)$" no-gzip=1 no-brotli=1
</IfModule>
